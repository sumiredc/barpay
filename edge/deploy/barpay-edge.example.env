# The edge device's settings, read by its systemd service (barpay-edge.service) as an
# EnvironmentFile: one NAME=value per line, with no quotes. Copy it to
# /etc/barpay-edge/barpay-edge.env, readable by root only, and fill in the empty values.
# The edge device does not start when a value is missing or malformed, and says which one.

# BarPay's base URL: http:// or https://, its host, and the port when it is not the default;
# without /v1.
BARPAY_URL=
# The edge device's shared secret: keys.edge_shared_secret in BarPay's barpay.toml. The only
# secret in this file. systemd takes quotes, backslashes and spaces at the ends as syntax, so
# use a secret of letters and digits only.
BARPAY_EDGE_SHARED_SECRET=

# Which kind of each part runs: the real parts on the Raspberry Pi 5, or fake for any of them.
# A fake lock opens nothing yet reports every unlock as worked.
BARPAY_EDGE_QR_READER=evdev
BARPAY_EDGE_LOCK=gpio
BARPAY_EDGE_MICROPHONE=alsa
BARPAY_EDGE_INDICATOR=gpio

# The QR reader's input device: the link the service's udev rule makes for it.
BARPAY_EDGE_QR_DEVICE=/dev/input/barpay-edge-qr

# The ALSA capture device of the microphone, such as plughw:CARD=Device,DEV=0 (the card's ID
# is in /proc/asound/cards). Empty: ALSA's default device.
BARPAY_EDGE_MICROPHONE_DEVICE=
# The store's tuning of the liveliness, in dBFS: the room's quiet level (0) and loudest
# level (1). The quiet level must be below the loudest, and the loudest at most 0.
BARPAY_EDGE_QUIET_DBFS=-50
BARPAY_EDGE_LOUDEST_DBFS=-20

# The GPIO chip of the Raspberry Pi 5's header, and the line of each part on it, as GPIO
# numbers (not pin numbers). Every line must differ.
BARPAY_EDGE_GPIO_CHIP=/dev/gpiochip0
BARPAY_EDGE_LED_RED_LINE=17
BARPAY_EDGE_LED_GREEN_LINE=27
BARPAY_EDGE_LED_BLUE_LINE=22
BARPAY_EDGE_BUZZER_LINE=23
BARPAY_EDGE_LOCK_LINE=24
# How long the gate stays open for one unlock, in seconds: more than 0 and at most 60.
BARPAY_EDGE_UNLOCK_SECONDS=5
